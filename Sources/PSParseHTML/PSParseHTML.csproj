<Project Sdk="Microsoft.NET.Sdk">

        <PropertyGroup>
            <Company>Evotec</Company>
            <Authors>Przemyslaw Klys</Authors>
            <VersionPrefix>1.0.3</VersionPrefix>
            <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
            <AssemblyName>PSParseHTML</AssemblyName>
            <AssemblyTitle>PSParseHTML</AssemblyTitle>
            <Copyright>(c) 2011 - 2024 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
            <LangVersion>latest</LangVersion>
        </PropertyGroup>

        <PropertyGroup>
            <!-- Enable XML documentation generation for XmlDoc2CmdletDoc -->
            <GenerateDocumentationFile>true</GenerateDocumentationFile>
        </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.2.0-beta.439" />
		<PackageReference Include="AngleSharp.Css" Version="1.0.0-beta.144" />
		<PackageReference Include="AngleSharp.Diffing" Version="1.0.0" />
		<PackageReference Include="AngleSharp.Js" Version="1.0.0-beta.36" />
		<!-- <PackageReference Include="DotNetSeleniumExtras.WaitHelpers" Version="3.11.0" /> -->
		<PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
		<PackageReference Include="Jsbeautifier" Version="0.0.1" />
		<PackageReference Include="NUglify" Version="1.21.11" />
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
		<PackageReference Include="PreMailer.Net" Version="2.6.0" />
		<!-- <PackageReference Include="Selenium.WebDriver" Version="4.16.2" /> -->
        </ItemGroup>


	<PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
		<DefineConstants>$(DefineConstants);FRAMEWORK</DefineConstants>
	</PropertyGroup>

</Project>
