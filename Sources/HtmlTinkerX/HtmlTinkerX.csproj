<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Company>Evotec</Company>
        <Authors>Przemyslaw Klys</Authors>
        <VersionPrefix>3.0.1</VersionPrefix>
        <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
        <AssemblyName>HtmlTinkerX</AssemblyName>
        <AssemblyTitle>HtmlTinkerX</AssemblyTitle>
        <Description>HTML, CSS, and JavaScript parsing, extraction, auditing, formatting, and browser automation for .NET and PowerShell.</Description>
        <PackageProjectUrl>https://github.com/EvotecIT/HtmlTinkerX</PackageProjectUrl>
        <RepositoryUrl>https://github.com/EvotecIT/HtmlTinkerX.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>html;css;javascript;web-scraping;web-audit;playwright;anglesharp;powershell</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OfficeImoVersion>3.2.3</OfficeImoVersion>
        <ChartForgeXVersion>1.6.0</ChartForgeXVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.7.1" />
        <PackageReference Include="AngleSharp.Css" Version="1.0.1" />
        <PackageReference Include="AngleSharp.Diffing" Version="1.1.1" />
        <PackageReference Include="AngleSharp.Io" Version="1.1.0" />
        <PackageReference Include="AngleSharp.Js" Version="1.0.1" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="Jint" Version="4.16.0" />
        <PackageReference Include="NUglify" Version="1.22.3" />
        <PackageReference Include="PreMailer.Net" Version="2.7.3" />
        <PackageReference Include="System.IO.Compression" Version="4.3.0" Condition=" '$(TargetFramework)' == 'net472' " />
        <PackageReference Include="System.Net.Http" Version="4.3.4" Condition=" '$(TargetFramework)' == 'net472' " />
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(ChartForgeXProjectPath)' != '' ">
        <ProjectReference Include="$(ChartForgeXProjectPath)" />
    </ItemGroup>

    <ItemGroup Condition=" '$(ChartForgeXProjectPath)' == '' ">
        <PackageReference Include="ChartForgeX" Version="$(ChartForgeXVersion)" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Threading.Channels" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Net.Http" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupNavigation.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupNavigation.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupContextRegistry.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupContextRegistry.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupCacheGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupCacheGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupAttributeGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupAttributeGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupAnimatedAttributeGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupAnimatedAttributeGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupFrameGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupFrameGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupCodeGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupCodeGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupDomGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupDomGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupAsyncConstructors.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupAsyncConstructors.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupMarkupGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupMarkupGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupRealmGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupRealmGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupTransportGuards.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupTransportGuards.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupXhrStaging.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupXhrStaging.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserPopupResourceQueue.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserPopupResourceQueue.js" />
        <EmbeddedResource Include="Playwright/Scripts/HtmlBrowserStorageInitialization.js"
                          LogicalName="HtmlTinkerX.Playwright.Scripts.HtmlBrowserStorageInitialization.js" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OfficeIMO.Html" Version="$(OfficeImoVersion)" />
        <PackageReference Include="OfficeIMO.Markdown.Html" Version="$(OfficeImoVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\MIGRATION.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>HtmlTinkerX.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>PSParseHTML.PowerShell</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <DefineConstants>$(DefineConstants);NETFRAMEWORK;FRAMEWORK</DefineConstants>
    </PropertyGroup>

</Project>
